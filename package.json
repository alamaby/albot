{
  "name": "albot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:hosted": "vitest run tests/integration tests/security tests/contract",
    "db:lint": "node scripts/db-lint.mjs",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/server/supabase/database.types.ts",
    "db:types:check": "node scripts/verify-generated-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@next-community/adapter-vercel": "^0.0.1-beta.29",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/build-utils": "^14.7.0",
    "@vercel/routing-utils": "^6.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "supabase": "2.108.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  }
}
