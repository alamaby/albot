# Salin file ini menjadi `.env.local` untuk development lokal.
# Jangan pernah mengisi nilai secret di file ini atau commit nilai asli.

# Environment
NODE_ENV=development

# Label environment aplikasi (development | production).
# Di Vercel otomatis diturunkan dari VERCEL_ENV, jadi tidak perlu di-set manual.
# APP_ENV=development

# Supabase (server-side only; jangan dipakai dengan prefix NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Reserved untuk milestone berikutnya. Jangan diisi pada Milestone 0.
# - Milestone 2: PROVIDER_KEY_ENCRYPTION_KEY
# - Milestone 3: TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, JOB_PROCESSOR_SECRET
# ---------------------------------------------------------------------------
# PROVIDER_KEY_ENCRYPTION_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# JOB_PROCESSOR_SECRET=
