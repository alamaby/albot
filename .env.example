# Salin file ini menjadi `.env.local` untuk development lokal.
# Jangan pernah mengisi nilai secret di file ini atau commit nilai asli.

# Environment
NODE_ENV=development

# Label environment aplikasi (development | production).
# Di Vercel otomatis diturunkan dari VERCEL_ENV, jadi tidak perlu di-set manual.
# APP_ENV=development

# Supabase (server-side only; jangan dipakai dengan prefix NEXT_PUBLIC_).
# SUPABASE_SECRET_KEY: format sb_secret_... (Supabase Secret Key, replacement
# for the legacy service-role key). Generate di Supabase dashboard
# Project Settings → API → "Secret keys". Minimal 1 karakter, harus prefix
# sb_secret_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Milestone 1 (GitHub Environments `development`/`production` + CLI lokal).
# Ref project non-secret boleh di .env; secret hanya ke GitHub/Vercel.
# ---------------------------------------------------------------------------
# SUPABASE_PROJECT_REF_DEV=
# SUPABASE_PROJECT_REF_PROD=
# SUPABASE_DB_PASSWORD_DEV=
# SUPABASE_DB_PASSWORD_PROD=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PUBLISHABLE_KEY_DEV=
# SUPABASE_PUBLISHABLE_KEY_PROD=

# ---------------------------------------------------------------------------
# Milestone 2: provider key encryption (base64, decode tepat 32 bytes).
# ---------------------------------------------------------------------------
PROVIDER_KEY_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Milestone 3: Telegram intake + durable jobs.
# TELEGRAM_BOT_TOKEN: format <bot_id>:<auth_key> dari @BotFather (dev bot).
# TELEGRAM_WEBHOOK_SECRET: random string, minimum 8 char URL-safe base64.
# JOB_PROCESSOR_SECRET: random string, minimum 32 char.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
JOB_PROCESSOR_SECRET=

# ---------------------------------------------------------------------------
# Milestone 4: provider reasoning keys untuk provisioning dev (opsional, lokal).
# Dipakai oleh scripts/seed-provider-config.mjs saat seed config + key ke
# Supabase dev. Nilai hanya di .env lokal (gitignored), tidak pernah di commit.
# Format bebas; script membaca env PROVIDER_KEY fallback bila --key tidak ada.
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# POLLINATIONS_API_KEY=

# ---------------------------------------------------------------------------
# Bynara providers (api-images.bynara.id / router.bynara.id).
# Dipakai oleh scripts/upsert-provider-key.mjs untuk provisioning 4 picker
# model image (bynara_a20f, bynara_a21f, bynara_grok, bynara_nbn) ke
# provider_keys. Reasoning (laguna-s-2.1, nemotron-3-ultra) sudah ter-keyed
# dari konfigurasi awal. Nilai hanya di .env.local.
# ---------------------------------------------------------------------------
BYNARA_API_KEY=
